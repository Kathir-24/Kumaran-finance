# ==============================================================================
# Kumaran Chits — Local Docker Infrastructure Environment (.env)
# ==============================================================================

# PostgreSQL 17 Database Credentials
POSTGRES_USER=chitflow
POSTGRES_PASSWORD=chitflow_dev_only
POSTGRES_DB=chitflow_dev
POSTGRES_PORT=5433

# Redis 7 In-Memory Cache & Queue
REDIS_PORT=6379

# MinIO S3-Compatible Local Object Storage
MINIO_ROOT_USER=chitflow_admin
MINIO_ROOT_PASSWORD=chitflow_storage_secret
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_DEFAULT_BUCKET=kumaran-chits-private

# Nginx Ingress Reverse Proxy
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
