# ==============================================================================
# Kumaran Chits — Environment Configuration Template (.env.example)
# Company: Kumaran Finance (Perundurai, Erode, Tamil Nadu)
# ==============================================================================

# Server Configuration
PORT=3000
NODE_ENV=development
API_PREFIX=api/v1

# Database Connection (PostgreSQL 17 on Port 5433 via Docker)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL="postgresql://chitflow:chitflow_dev_only@127.0.0.1:5433/chitflow_dev?schema=public"

# Redis Configuration (BullMQ background jobs & OTP rate-limiting)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

# Bull Board Queue Monitor UI (Mounted at /admin/queues)
BULL_BOARD_USER=admin
BULL_BOARD_PASSWORD=chitflow_secret

# Prometheus Metrics Scrape Authentication (Mounted at /metrics)
METRICS_USER=admin
METRICS_PASSWORD=chitflow_secret

# Authentication & Security (JWT)
JWT_SECRET="replace-with-a-secure-random-64-character-secret-in-production"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="7d"

# CORS Allowed Web Origins (comma-separated origins for admin web dashboard)
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001"

# Express Reverse-Proxy Trust Configuration (DEF-FE-06)
# Default (when omitted): "loopback, linklocal, uniquelocal"
# Supports "true", "false", hop count (e.g. "2"), or comma-separated trusted CIDRs/subnets.
TRUST_PROXY="loopback, linklocal, uniquelocal"

# Kumaran Chits Business Defaults (Locked per ADR-04)
DEFAULT_FOREMAN_COMMISSION_PERCENT=4.00
PRIMARY_BRANCH_CODE=PRD
PRIMARY_BRANCH_NAME="Perundurai Head Office"
PRIMARY_BRANCH_DISTRICT="Erode"
PRIMARY_BRANCH_STATE="Tamil Nadu"

# ==============================================================================
# Object Storage (KYC Scans, Signed Cheque Photos, Bilingual PDF Receipts)
# Driver: 'local' (filesystem in ./storage/uploads) or 's3' (Universal S3 Protocol)
# Compatible with: Cloudflare R2 (Production), MinIO (Local), DigitalOcean Spaces, or Backblaze B2
# ==============================================================================
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./storage/uploads

# Universal S3 Settings (Required when STORAGE_DRIVER=s3)
S3_BUCKET=kumaran-chits-private
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=chitflow_admin
S3_SECRET_ACCESS_KEY=chitflow_storage_secret

# For Local MinIO in Docker:
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_FORCE_PATH_STYLE=true

# For Cloudflare R2:
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com

# For DigitalOcean Spaces (Bangalore, India):
# S3_ENDPOINT=https://blr1.digitaloceanspaces.com

# ==============================================================================
# Pluggable SMS Notification Engine (TRAI DLT Compliant)
# Driver: 'mock' (Default for local dev/testing) or 'msg91' (Indian Production Gateway)
# ==============================================================================
SMS_DRIVER=mock
SMS_SENDER_ID=KMRCHT
SMS_MAX_RETRIES=2
SMS_RETRY_BASE_DELAY_MS=400
SMS_REQUEST_TIMEOUT_MS=15000

# Required when SMS_DRIVER=msg91:
# MSG91_AUTH_KEY=your_msg91_authkey_here
# MSG91_DLT_TE_ID=your_dlt_telecom_entity_id_here
# MSG91_DLT_OTP_TEMPLATE_ID=1407169823412093847
# MSG91_DLT_RECEIPT_TEMPLATE_ID=1407169823412093848
# MSG91_DLT_AUCTION_TEMPLATE_ID=1407169823412093849
# MSG91_DLT_DEFAULT_TEMPLATE_ID=1407169823412093850
# MSG91_DLT_AUCTION_RESULT_TEMPLATE_ID=1407169823412093851

# ==============================================================================
# Mobile Push Notification Engine (Firebase Cloud Messaging)
# Driver: 'mock' (Default for local dev/testing) or 'firebase' (Android/iOS devices)
# ==============================================================================
PUSH_DRIVER=mock
# Required when PUSH_DRIVER=firebase:
# FIREBASE_PROJECT_ID=your-firebase-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# ==============================================================================
# Sentry Error Monitoring & APM Crash Tracking (@sentry/nestjs)
# ==============================================================================
# Sentry DSN (Leave empty for safe-bypass mode during local dev / test / CI)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# ==============================================================================
# Native Zero-Fee One-Tap UPI Intent Configuration (Direct Karur Vysya Bank Current Account)
# ==============================================================================
COMPANY_UPI_VPA="kumaranfinance@kvb"
COMPANY_UPI_NAME="Kumaran Finance"

