# ==============================================================================
# Kumaran Chits — Environment Configuration Template (.env.example)
# Company: Kumaran Finance (Perundurai, Erode, Tamil Nadu)
# ==============================================================================

# Server Configuration
PORT=3000
NODE_ENV=development
API_PREFIX=api/v1

# Database Connection (PostgreSQL 17 on Port 5433 via Docker)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL="postgresql://chitflow:chitflow_dev_only@127.0.0.1:5433/chitflow_dev?schema=public"

# Redis Configuration (BullMQ background jobs & OTP rate-limiting)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Authentication & Security (JWT)
JWT_SECRET="replace-with-a-secure-random-64-character-secret-in-production"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="7d"

# Kumaran Chits Business Defaults (Locked per ADR-04)
DEFAULT_FOREMAN_COMMISSION_PERCENT=4.00
PRIMARY_BRANCH_CODE=PRD
PRIMARY_BRANCH_NAME="Perundurai Head Office"
PRIMARY_BRANCH_DISTRICT="Erode"
PRIMARY_BRANCH_STATE="Tamil Nadu"

# ==============================================================================
# Object Storage (KYC Scans, Signed Cheque Photos, Bilingual PDF Receipts)
# Driver: 'local' (filesystem in ./storage/uploads) or 's3' (Universal S3 Protocol)
# Compatible with: MinIO (Local), Cloudflare R2, DigitalOcean Spaces, Backblaze B2, or AWS S3
# ==============================================================================
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./storage/uploads

# Universal S3 Settings (Required when STORAGE_DRIVER=s3)
S3_BUCKET=kumaran-chits-private
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=chitflow_admin
S3_SECRET_ACCESS_KEY=chitflow_storage_secret

# For Local MinIO in Docker:
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_FORCE_PATH_STYLE=true

# For Cloudflare R2:
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com

# For DigitalOcean Spaces (Bangalore, India):
# S3_ENDPOINT=https://blr1.digitaloceanspaces.com
