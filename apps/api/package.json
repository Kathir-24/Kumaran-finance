{
  "name": "api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint src/ test/",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --watch",
    "test:cov": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --coverage",
    "test:debug": "node --inspect-brk --experimental-vm-modules -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config ./test/jest-e2e.json --runInBand",
    "test:db:seed": "ts-node scripts/ops/seed-test-db.ts",
    "test:e2e:fresh": "ts-node scripts/ops/seed-test-db.ts && node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config ./test/jest-e2e.json --runInBand",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "prisma db seed",
    "prisma:studio": "prisma studio",
    "config:verify": "node -e \"const { execFileSync } = require('child_process'); const path = require('path'); const root = path.resolve('..', '..'); if (process.platform === 'win32') { execFileSync('powershell', ['-ExecutionPolicy', 'Bypass', '-File', path.join(root, 'infra/scripts/verify-config.ps1')], { cwd: root, stdio: 'inherit' }); } else { execFileSync('bash', [path.join(root, 'infra/scripts/verify-config.sh')], { cwd: root, stdio: 'inherit' }); }\"",
    "openapi:export": "ts-node scripts/codegen/export-openapi.ts",
    "db:backup:s3": "ts-node scripts/ops/backup-to-s3.ts",
    "db:backup:health": "ts-node scripts/ops/backup-health.ts",
    "db:restore:s3": "ts-node scripts/ops/restore-from-s3.ts",
    "db:drp-drill": "ts-node scripts/ops/drp-drill.ts",
    "test:stress": "ts-node scripts/stress/verify-concurrency-stress.ts",
    "test:ingress": "ts-node scripts/stress/verify-docker-nginx.ts",
    "test:simulation": "ts-node scripts/stress/verify-full-20month-simulation.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@bull-board/api": "^9.10.4",
    "@bull-board/express": "^9.10.4",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/client": "^6.19.3",
    "@sentry/nestjs": "^11.8.0",
    "@smithy/node-http-handler": "^4.14.2",
    "bcrypt": "^6.0.0",
    "bullmq": "^6.3.17",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "firebase-admin": "^14.5.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "otplib": "^13.5.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdfkit": "^0.20.2",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@kumaran/api-client": "workspace:*",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/ioredis": "^4.28.10",
    "@types/jest": "^30.0.0",
    "@types/node": "catalog:",
    "@types/passport-jwt": "^4.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^7.0.0",
    "dotenv": "^18.0.8",
    "jest": "^30.0.0",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "prisma": "^6.19.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.0",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "catalog:"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  }
}
