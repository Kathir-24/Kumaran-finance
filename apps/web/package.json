  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "next lint --max-warnings 0 --report-unused-disable-directives-severity error",
    "test": "node --experimental-strip-types --test test/*.spec.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "test:visual": "playwright test e2e/visual-audit.e2e.spec.ts",
    "report:visual": "node scripts/generate-visual-gallery.mjs",
    "typecheck": "next typegen && tsc --noEmit && tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@hookform/resolvers": "^4.1.0",
    "@kumaran/api-client": "workspace:*",
