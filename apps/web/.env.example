# ==============================================================================
# Kumaran Chits — Web Operations Portal Environment Specification (.env)
# Company: Kumaran Finance (Head Office: Perundurai, Erode, Tamil Nadu)
# Application: Next.js 15 Web Portal (Staff & Customer Operations Dashboard)
# ==============================================================================

# Backend REST API Gateway Base URL
# - Local Development: http://localhost:3000
# - Docker Fullstack / Nginx Proxy: http://localhost (or /api/v1 via reverse proxy)
# - Production Server: https://api.kumaranfinance.com
NEXT_PUBLIC_API_URL=http://localhost:3000

# BullMQ Queue Monitor Dashboard URL (Super Admin / Partner access)
# - Local Development: http://localhost:3000/admin/queues
# - Production Server: https://api.kumaranfinance.com/admin/queues
NEXT_PUBLIC_BULL_BOARD_URL=http://localhost:3000/admin/queues

# Application Server Port (Defaults to 3001 to prevent collisions with API port 3000)
PORT=3001

# Node Runtime Environment (development | production | test)
NODE_ENV=development

# Standalone Output Flag for Next.js Compilation
# Set to 'true' in Dockerfile / CI builds to bundle minimal standalone server.js
# Leave undefined in local Windows host environments to prevent EPERM symlink restrictions
BUILD_STANDALONE=false

# Disable Next.js Anonymous Telemetry Data Collection
NEXT_TELEMETRY_DISABLED=1
