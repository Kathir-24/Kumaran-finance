# Git & VCS
.git
.gitignore
.github

# Dependencies & Lockfiles (installed during Docker build)
node_modules
apps/*/node_modules
packages/*/node_modules

# Build Outputs & Caches
.next
apps/*/.next
dist
apps/*/dist
packages/*/dist
*.tsbuildinfo

# Test Outputs, Reports & Traces
test-results
apps/*/test-results
playwright-report
apps/*/playwright-report

# Environment Files (injected via Docker Compose / runtime)
.env
.env.local
.env.*.local
apps/*/.env
apps/*/.env.local
apps/*/.env.*.local
!.env.example
!apps/*/.env.example

# IDE & Editor Artifacts
.vscode
.idea
.gemini
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Documentation & Non-Code Assets
docs
backups
scripts/*.ps1
