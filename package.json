{
  "name": "kumaran-finance-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "description": "Monorepo for Kumaran Chits operations platform (Kumaran Finance, Perundurai)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start:dev": "pnpm --filter api run start:dev",
    "build": "pnpm --filter api run build",
    "test": "pnpm --filter api test",
    "test:e2e": "pnpm --filter api run test:e2e",
    "lint": "pnpm --filter api run lint",
    "prisma:generate": "pnpm --filter api run prisma:generate",
    "prisma:migrate": "pnpm --filter api run prisma:migrate",
    "prisma:seed": "pnpm --filter api run prisma:seed",
    "prisma:studio": "pnpm --filter api run prisma:studio",
    "docker:up": "docker compose -f infra/docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f infra/docker/docker-compose.yml down",
    "docker:logs": "docker compose -f infra/docker/docker-compose.yml logs -f",
    "docker:fullstack:up": "docker compose -f infra/docker/docker-compose.fullstack.yml up -d --build",
    "docker:fullstack:down": "docker compose -f infra/docker/docker-compose.fullstack.yml down",
    "docker:web:build": "docker build -f apps/web/Dockerfile -t chitflow-web .",
    "db:backup:s3": "pnpm --filter api exec ts-node scripts/backup-to-s3.ts",
    "db:restore:s3": "pnpm --filter api exec ts-node scripts/restore-from-s3.ts",
    "db:backups:list": "pnpm --filter api exec ts-node scripts/restore-from-s3.ts --list",
    "db:drp:drill": "pnpm --filter api exec ts-node scripts/drp-drill.ts",
    "test:stress": "pnpm --filter api exec ts-node scripts/verify-concurrency-stress.ts",
    "test:ingress": "pnpm --filter api exec ts-node scripts/verify-docker-nginx.ts",
    "codegen:spec": "pnpm --filter api run openapi:export",
    "codegen:ts": "pnpm --filter @kumaran/api-client generate && pnpm --filter @kumaran/api-client build",
    "codegen:dart": "node --experimental-strip-types scripts/generate-dart-api.ts",
    "codegen:all": "pnpm codegen:spec && pnpm codegen:ts && pnpm codegen:dart",
    "codegen:types": "openapi-typescript docs/03-architecture/openapi-spec.json -o docs/03-architecture/openapi-types.ts",
    "web:dev": "pnpm --filter web run dev",
    "web:build": "pnpm --filter web run build",
    "web:start": "pnpm --filter web run start",
    "web:lint": "pnpm --filter web run lint",
    "web:typecheck": "pnpm --filter web run typecheck",
    "test:web:e2e": "pnpm --filter web run test:e2e"
  },
  "keywords": [
    "chit-fund",
    "fintech",
    "kumaran-finance",
    "tamil-nadu"
  ],
  "author": "Kumaran Finance",
  "license": "UNLICENSED",
  "devDependencies": {
    "openapi-typescript": "^7.13.0"
  }
}
